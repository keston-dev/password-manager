@{
    ViewData["Title"] = "Welcome";
}

<div class="w-full h-full flex flex-col items-center justify-center gap-10 py-10 overflow-y-auto">
    <div class="flex flex-col items-center gap-6 text-center max-w-sm w-full px-4">

        <div class="flex flex-col items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-purple-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>
            </svg>
            <h1 class="text-xl font-bold text-white">Password Manager</h1>
            <p class="text-zinc-600 text-xs">Store and manage your credentials securely.</p>
        </div>

        <div class="w-full flex flex-col items-center gap-3">
            <a asp-controller="Authentication" asp-action="Login"
               class="flex items-center justify-center gap-3 bg-white hover:bg-zinc-100 active:scale-95 transition-all duration-150 text-zinc-900 text-sm font-semibold rounded-xl px-6 py-3 w-full">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-5 h-5 shrink-0">
                    <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                    <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                    <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
                    <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                </svg>
                Sign in with Google
            </a>
            <p class="text-xs text-zinc-600">Your entries are private to your account.</p>
        </div>

    </div>

    <div class="w-full max-w-sm px-4 flex flex-col gap-4">

        <div class="flex items-center gap-3">
            <div class="h-px flex-1 bg-zinc-700/60"></div>
            <span class="text-xs text-zinc-600 uppercase tracking-widest">Free Tools</span>
            <div class="h-px flex-1 bg-zinc-700/60"></div>
        </div>

        <p class="text-xs text-zinc-600 text-center">No account needed.</p>

        <a asp-action="PasswordGenerator" asp-controller="Tools"
           class="flex items-center gap-4 bg-zinc-800 border border-zinc-700 hover:border-purple-500/50 hover:bg-zinc-700/50 rounded-xl p-4 transition-all duration-150 group">
            <div class="w-9 h-9 rounded-lg bg-orange-500/20 border border-orange-400/20 flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-orange-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M18 8a6 6 0 01-7.743 5.743L10 14l-1 1-1 1H6v2H2v-4l4.257-4.257A6 6 0 1118 8zm-6-4a1 1 0 100 2 2 2 0 012 2 1 1 0 102 0 4 4 0 00-4-4z" clip-rule="evenodd" />
                </svg>
            </div>
            <div class="flex flex-col min-w-0">
                <p class="text-sm font-semibold text-white">Password Generator</p>
                <p class="text-xs text-zinc-500 mt-0.5">Generate strong, random passwords.</p>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-zinc-600 group-hover:text-zinc-400 ml-auto shrink-0 transition-colors" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
            </svg>
        </a>

    </div>

</div>