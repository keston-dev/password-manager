@model Account

@section Sidebar {
    <div class="flex flex-col w-full h-full relative">

        <div class="px-4 pt-5 pb-3">
            <p class="text-xs font-semibold uppercase tracking-widest text-zinc-500">Entries</p>
        </div>

        <div class="flex flex-col flex-1 overflow-y-auto">
            @foreach (Entry entry in @Model.Entries)
            {
                <div class="group flex items-center gap-2 px-3 py-3 border-b border-zinc-700/50 hover:bg-zinc-700/30 transition-all duration-200">
                    <a class="flex-1 flex flex-col min-w-0 cursor-pointer"
                       asp-route-entryId="@entry.EntryId"
                       asp-controller="Entries"
                       asp-action="View">
                        <p class="text-sm font-semibold text-white truncate">@entry.Hostname</p>
                        <span class="mt-1 inline-block bg-zinc-700 text-zinc-300 rounded-full px-2 py-0.5 text-xs font-medium w-fit truncate max-w-full">
                            @entry.Username
                        </span>
                    </a>
                    <div class="flex items-center gap-1 shrink-0 duration-150">
                        <a asp-route-entryId="@entry.EntryId"
                           asp-controller="Entries"
                           asp-action="Edit"
                           class="w-7 h-7 flex items-center justify-center rounded-lg text-zinc-500 hover:text-purple-400 hover:bg-purple-500/10 transition-all duration-150"
                           title="Edit">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                                <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z"/>
                            </svg>
                        </a>

                        <form asp-controller="Entries" asp-action="Delete" method="post" onsubmit="return confirm('Delete this entry?')">
                            <input type="hidden" name="entryId" value="@entry.EntryId"/>
                            <button type="submit"
                                    class="w-7 h-7 flex items-center justify-center rounded-lg text-zinc-500 hover:text-red-400 hover:bg-red-500/10 transition-all duration-150"
                                    title="Delete">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"/>
                                </svg>
                            </button>
                        </form>
                    </div>
                </div> 
            }
        </div>

        <div class="p-4 border-t border-zinc-700/50">
                <a asp-controller="Entries"
                   asp-action="Add"
                   asp-route-accountId="@Model.AccountId"
                   class="w-full flex items-center justify-center gap-2 bg-purple-700 hover:bg-purple-600 active:scale-95 transition-all duration-150 text-white text-sm font-semibold rounded-lg py-3 px-4">
                    Create New Entry
                </a>
        </div>
    </div>
}

<div class="w-full bg-zinc-900 h-full text-white p-8 flex flex-col gap-12 overflow-y-auto rounded-xl">

    <div class="flex flex-col gap-1">
        <h1 class="text-2xl font-bold text-white">Welcome back, <b>@(User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? Model.Username)</b></h1>
        <p class="text-sm text-zinc-500">You have <span class="text-white font-semibold">@Model.Entries.Count</span> @(Model.Entries.Count == 1 ? "entry" : "entries") saved. Select one from the sidebar or create a new one.</p>
    </div>

    <div class="flex items-center gap-4">
        <div class="h-px flex-1 bg-zinc-700/60"></div>
        <span class="text-xs text-zinc-600 uppercase tracking-widest">Tools</span>
        <div class="h-px flex-1 bg-zinc-700/60"></div>
    </div>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2">

        <div class="flex flex-col gap-3 bg-zinc-800 border border-zinc-700 rounded-xl p-5 ">
            <div class="w-9 h-9 rounded-lg bg-orange-500/20 border border-orange-400/20 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-orange-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M18 8a6 6 0 01-7.743 5.743L10 14l-1 1-1 1H6v2H2v-4l4.257-4.257A6 6 0 1118 8zm-6-4a1 1 0 100 2 2 2 0 012 2 1 1 0 102 0 4 4 0 00-4-4z" clip-rule="evenodd" />
                </svg>
            </div>
            <div>
                <p class="text-sm font-semibold text-white">Password Generator</p>
                <p class="text-xs text-zinc-500 mt-0.5">Generate strong passwords with custom rules.</p>
            </div>
            <a class="text-xs underline text-zinc-400 uppercase tracking-widest" asp-action="PasswordGenerator" asp-controller="Tools">View</a>
        </div>

        <div class="flex flex-col gap-3 bg-zinc-800 border border-zinc-700 rounded-xl p-5 opacity-50 cursor-not-allowed">
            <div class="w-9 h-9 rounded-lg bg-red-500/20 border border-red-500/20 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h4a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd" />
                </svg>
            </div>
            <div>
                <p class="text-sm font-semibold text-white">Password Audit</p>
                <p class="text-xs text-zinc-500 mt-0.5">Check for reused passwords.</p>
            </div>
            <span class="text-xs text-zinc-600 uppercase tracking-widest">Coming soon</span>
        </div>

        <div class="flex flex-col gap-3 bg-zinc-800 border border-zinc-700 rounded-xl p-5 opacity-50 cursor-not-allowed">
            <div class="w-9 h-9 rounded-lg bg-green-500/20 border border-green-500/20 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-green-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM6.293 6.707a1 1 0 010-1.414l3-3a1 1 0 011.414 0l3 3a1 1 0 01-1.414 1.414L11 5.414V13a1 1 0 11-2 0V5.414L7.707 6.707a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                </svg>
            </div>
            <div>
                <p class="text-sm font-semibold text-white">Import & Export</p>
                <p class="text-xs text-zinc-500 mt-0.5">Import your passwords or export via CSV.</p>
            </div>
            <span class="text-xs text-zinc-600 uppercase tracking-widest">Coming soon</span>
        </div>

    </div>

</div>