@model PasswordManager.ViewModels.EntryViewModel

@section Sidebar {
  <div class="flex flex-col w-full h-full relative">

    <div class="px-4 pt-5 pb-3">
      <p class="text-xs font-semibold uppercase tracking-widest text-zinc-500">Entries</p>
    </div>
    
        <div class="flex flex-col flex-1 overflow-y-auto">
            @foreach (Entry entry in @Model.Account.Entries)
            {
                <div class="group flex items-center gap-2 px-3 py-3 border-b border-zinc-700/50 hover:bg-zinc-700/30 transition-all duration-200">
                    <a class="flex-1 flex flex-col min-w-0 cursor-pointer"
                       asp-route-entryId="@entry.EntryId"
                       asp-controller="Entries"
                       asp-action="View">
                        <p class="text-sm font-semibold text-white truncate">@entry.Hostname</p>
                        <span class="mt-1 inline-block bg-zinc-700 text-zinc-300 rounded-full px-2 py-0.5 text-xs font-medium w-fit truncate max-w-full">
                            @entry.Username
                        </span>
                    </a>
                    <div class="flex items-center gap-1 shrink-0 duration-150">
                        <a asp-route-entryId="@entry.EntryId"
                           asp-controller="Entries"
                           asp-action="Edit"
                           class="w-7 h-7 flex items-center justify-center rounded-lg text-zinc-500 hover:text-purple-400 hover:bg-purple-500/10 transition-all duration-150"
                           title="Edit">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                                <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z"/>
                            </svg>
                        </a>

                        <form asp-controller="Entries" asp-action="Delete" method="post" onsubmit="return confirm('Delete this entry?')">
                            <input type="hidden" name="entryId" value="@entry.EntryId"/>
                            <button type="submit"
                                    class="w-7 h-7 flex items-center justify-center rounded-lg text-zinc-500 hover:text-red-400 hover:bg-red-500/10 transition-all duration-150"
                                    title="Delete">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"/>
                                </svg>
                            </button>
                        </form>
                    </div>
                </div> 
            }
        </div>

    <div class="p-4 border-t border-zinc-700/50">
        <a asp-controller="Entries"
           asp-action="Add"
           asp-route-accountId="@Model.Account.AccountId"
           class="w-full flex items-center justify-center gap-2 bg-purple-700 hover:bg-purple-600 active:scale-95 transition-all duration-150 text-white text-sm font-semibold rounded-lg py-3 px-4">
          Create New Entry
        </a>
    </div>

  </div>
}

<div class="w-full bg-zinc-900 h-full text-white p-8 flex flex-col rounded-xl gap-6 overflow-y-auto">

  <div class="flex  gap-4">
    <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 overflow-hidden">
      <img
        src="https://icon.horse/icon/@(Uri.TryCreate(Model.ActiveEntry.Hostname, UriKind.Absolute, out var uri) ? uri.Host : Model.ActiveEntry.Hostname)"
        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
        class="w-full h-full rounded-full object-contain" />
      <div style="display:none" class="w-10 h-10 rounded-xl bg-zinc-800 border border-zinc-700 flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-zinc-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <line x1="2" y1="12" x2="22" y2="12"/>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
        </svg>
      </div>
    </div>  
    <div>
      <p class="text-2xl font-bold text-white">@Model.ActiveEntry.Hostname</p>
    </div>
  </div>

  <div class="flex flex-col gap-5 max-w-md w-full">

    <div class="flex flex-col gap-2">
      <label class="text-xs font-semibold uppercase tracking-widest text-zinc-500">Email</label>
      <div class="flex items-center gap-2">
        <div class="relative flex-1">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-zinc-500 pointer-events-none">            
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="5" width="18" height="14" rx="2"/><polyline points="3 7 12 13 21 7"/>
            </svg>
          </span>
          <input type="text" value="@Model.ActiveEntry.Email"
                 class="w-full cursor-not-allowed bg-zinc-800 border border-zinc-700 rounded-xl pl-9 pr-4 py-3 text-white text-sm outline-none"  disabled/>
        </div>
        <button id="copy-email-btn"
                onclick="copyField('@Model.ActiveEntry.Email', 'copy-email-btn')"
                class="shrink-0 w-9 h-9 flex items-center justify-center rounded-xl bg-zinc-800 border border-zinc-700 text-zinc-400 hover:text-purple-400 hover:border-purple-500 transition-all duration-150"
                title="Copy email">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
          </svg>
        </button>
      </div>
    </div>

    <div class="flex flex-col gap-2">
      <label class="text-xs font-semibold uppercase tracking-widest text-zinc-500">Username</label>
      <div class="flex items-center gap-2">
        <div class="relative flex-1">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-zinc-500 pointer-events-none">            
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
            </svg>
          </span>
          <input type="text" value="@Model.ActiveEntry.Username"
                 class="w-full cursor-not-allowed bg-zinc-800 border border-zinc-700 rounded-xl pl-9 pr-4 py-3 text-white text-sm outline-none" disabled/>
        </div>
        <button id="copy-user-btn"
                onclick="copyField('@Model.ActiveEntry.Username', 'copy-user-btn')"
                class="shrink-0 w-9 h-9 flex items-center justify-center rounded-xl bg-zinc-800 border border-zinc-700 text-zinc-400 hover:text-purple-400 hover:border-purple-500 transition-all duration-150"
                title="Copy username">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
          </svg>
        </button>
      </div>
    </div>


    <div class="flex flex-col gap-2">
      <label class="text-xs font-semibold uppercase tracking-widest text-zinc-500">Password</label>
      <div class="flex items-center gap-2">
        <div class="relative flex-1">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-zinc-500 pointer-events-none">            
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>
            </svg>
          </span>
          <input 
            id="password-input" 
            type="password"  
            value="@Model.ActiveEntry.Password"
            class="w-full cursor-not-allowed bg-zinc-800 border border-zinc-700 rounded-xl pl-9 pr-4 py-3 text-white text-sm outline-none font-mono tracking-widest" 
            disabled 
            />
        </div>
        <button id="copy-pw-btn"
                onclick="copyField('@Model.ActiveEntry.Password', 'copy-pw-btn')"
                class="flex-shrink-0 w-9 h-9 flex items-center justify-center rounded-xl bg-zinc-800 border border-zinc-700 text-zinc-400 hover:text-purple-400 hover:border-purple-500 transition-all duration-150"
                title="Copy password">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
          </svg>
        </button>
        <button id="toggle-pw-btn"
                onclick="togglePassword()"
                class="flex-shrink-0 w-9 h-9 flex items-center justify-center rounded-xl bg-zinc-800 border border-zinc-700 text-zinc-400 hover:text-purple-400 hover:border-purple-500 transition-all duration-150"
                title="Toggle visibility">
          <svg id="eye-show" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
          </svg>
          <svg id="eye-hide" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/>
            <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/>
            <line x1="1" y1="1" x2="23" y2="23"/>
          </svg>
        </button>
      </div>

      <div class="flex flex-col gap-1.5 mt-1">
        <div class="flex gap-1">
          <div id="bar-1" class="h-1 flex-1 rounded-full bg-zinc-700 transition-colors duration-300"></div>
          <div id="bar-2" class="h-1 flex-1 rounded-full bg-zinc-700 transition-colors duration-300"></div>
          <div id="bar-3" class="h-1 flex-1 rounded-full bg-zinc-700 transition-colors duration-300"></div>
          <div id="bar-4" class="h-1 flex-1 rounded-full bg-zinc-700 transition-colors duration-300"></div>
        </div>
        <div class="flex items-center justify-between">
          <p id="strength-label" class="text-xs "></p>
        </div>
        @if (Model.PasswordReuseCount > 0)
        {
          <div class="flex items-center gap-1.5 text-xs text-yellow-400 mt-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
            </svg>
            Password reused @Model.PasswordReuseCount @(Model.PasswordReuseCount == 1 ? "time" : "times") across other entries
          </div>
        }
        else
        {
          <div class="flex items-center gap-1.5 text-xs text-green-400 mt-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            Password is unique across your vault
          </div>
        }
      </div>

    </div>

  </div>
</div>

@section Scripts {
<script>
  function copyField(value, btnId) {
    navigator.clipboard.writeText(value)
    const btn = document.getElementById(btnId)
    const original = btn.innerHTML
    btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`
    btn.classList.add('text-purple-400', 'border-purple-500')
    setTimeout(() => {
      btn.innerHTML = original
      btn.classList.remove('text-purple-400', 'border-purple-500')
    }, 1500)
  }

  function togglePassword() {
    const input = document.getElementById('password-input')
    const eyeShow = document.getElementById('eye-show')
    const eyeHide = document.getElementById('eye-hide')
    const isHidden = input.type === 'password'
    input.type = isHidden ? 'text' : 'password'
    eyeShow.classList.toggle('hidden', isHidden)
    eyeHide.classList.toggle('hidden', !isHidden)
  }

  function updateStrength() {
    const password = document.getElementById('password-input').value
    const bars = ['bar-1', 'bar-2', 'bar-3', 'bar-4']
    if (!password) {
      bars.forEach(id => document.getElementById(id).className = 'h-1 flex-1 rounded-full bg-zinc-700 transition-colors duration-300')
      document.getElementById('strength-label').textContent = ''
      return
    }

    
    const result = window.getPasswordStrength(password)

  
    
    let score = result.score 

    const colorMap = ['bg-red-500', 'bg-yellow-500', 'bg-green-500', 'bg-sky-500']
    const labelMap = [['Weak', 'text-red-400'], ['Fair', 'text-yellow-400'], ['Good', 'text-green-400'], ['Strong', 'text-sky-400']]

    bars.forEach((id, idx) => {
      document.getElementById(id).className =
        `h-1 flex-1 rounded-full transition-colors duration-300 ${idx < score ? colorMap[score - 1] : 'bg-zinc-700'}`
    })

    const [label, color] = labelMap[score - 1] ?? ['', 'text-zinc-500']
    const el = document.getElementById('strength-label')
    el.textContent = label
    el.className = `text-xs font-medium ${color}`
  }

  document.addEventListener('DOMContentLoaded', updateStrength)
</script>
}