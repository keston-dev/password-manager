
@section Sidebar {
    <div class="flex flex-col w-full h-full relative">
        <div class="px-4 pt-5 pb-3">
            <p class="text-xs font-semibold uppercase tracking-widest text-zinc-500">Tools</p>
        </div>
        <div class="flex flex-col flex-1 overflow-y-auto">
            <div class="group flex items-center gap-2 px-3 py-3 border-b border-zinc-700/50 hover:bg-zinc-700/30 transition-all duration-200">
                <a class="flex-1 flex flex-col min-w-0 cursor-pointer"
                   asp-action="Index"
                   asp-controller="Home">
                    <p class="text-sm font-semibold text-white truncate">Back to Home</p>
                </a>
            </div> 
            <div class="group flex items-center gap-2 px-3 py-3 border-b border-zinc-700/50 hover:bg-zinc-700/30 transition-all duration-200">
                <a class="flex-1 flex flex-col min-w-0 cursor-pointer"
                   asp-action="PasswordGenerator">
                    
                    <p class="text-sm font-semibold text-white truncate">Password Generator</p>
                </a>
            </div>
            <div class="group flex items-center gap-2 px-3 py-3 border-b border-zinc-700/50 hover:bg-zinc-700/30 opacity-30 transition-all duration-200">
                <span class="flex-1 flex flex-col min-w-0 cursor-not-allowed">
                    <p class="text-sm font-semibold text-white truncate">Password Audit</p>
                </span>
            </div>
            <div class="group flex items-center gap-2 px-3 py-3 border-b border-zinc-700/50 hover:bg-zinc-700/30 opacity-30 transition-all duration-200">
                <span class="flex-1 flex flex-col min-w-0 cursor-not-allowed">
                    <p class="text-sm font-semibold text-white truncate">Import Your Passwords</p>
                </span>
            </div>
        </div>
        
    </div>
}


<div class="flex flex-col gap-6 max-w-md w-full">
    <h1 class="text-2xl text-white mb-2">Password Generator</h1>
        <div class="flex items-center gap-2">
            <div class="relative flex-1">
                <input id="generated-password"
                       type="text"
                       disabled
                       placeholder="Click generate..."
                       class="w-full bg-zinc-800 border border-zinc-700 rounded-xl px-4 py-3 text-sm text-white placeholder-zinc-600 outline-none font-mono tracking-widest cursor-not-allowed" />
            </div>
            <button onclick="copyPassword()"
                    id="copy-btn"
                    class="shrink-0 w-10 h-10 flex items-center justify-center rounded-xl bg-zinc-800 border border-zinc-700 text-zinc-400 hover:text-purple-400 hover:border-purple-500 transition-all duration-150"
                    title="Copy to clipboard">
                <svg id="copy-icon" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                </svg>
                <svg id="check-icon" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 hidden text-green-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
            </button>
        </div>

        <div class="flex flex-col gap-1.5">
            <div class="flex gap-1">
                <div id="bar-1" class="h-1 flex-1 rounded-full bg-zinc-700 transition-colors duration-300"></div>
                <div id="bar-2" class="h-1 flex-1 rounded-full bg-zinc-700 transition-colors duration-300"></div>
                <div id="bar-3" class="h-1 flex-1 rounded-full bg-zinc-700 transition-colors duration-300"></div>
                <div id="bar-4" class="h-1 flex-1 rounded-full bg-zinc-700 transition-colors duration-300"></div>
            </div>
            <p id="strength-label" class="text-xs font-medium text-zinc-500"></p>
        </div>

        <div class="flex flex-col gap-5 bg-zinc-800 border border-zinc-700 rounded-xl p-5">

            <div class="flex flex-col gap-3">
                <div class="flex items-center justify-between">
                    <label class="text-xs font-semibold uppercase tracking-widest text-zinc-500">Length</label>
                    <span id="length-display" class="text-sm font-bold text-white bg-zinc-700 rounded-lg px-2.5 py-0.5">16</span>
                </div>
                <input id="length-slider"
                       type="range"
                       min="8" max="32" value="16"
                       oninput="onSlider(this.value)"
                       class="w-full accent-purple-500 cursor-pointer" />
                <div class="flex justify-between text-xs text-zinc-600">
                    <span>8</span>
                    <span>32</span>
                </div>
            </div>

            <div class="h-px bg-zinc-700/60"></div>

            <div class="flex flex-col gap-4">
                <label class="flex items-center justify-between cursor-pointer group">
                    <div class="flex flex-col">
                        <span class="text-sm font-medium text-white">Uppercase Letters</span>
                        <span class="text-xs text-zinc-500">Include A–Z</span>
                    </div>
                    <div class="relative">
                        <input id="toggle-uppercase" type="checkbox" checked class="sr-only peer" onchange="generate()" />
                        <div class="w-10 h-6 bg-zinc-700 peer-checked:bg-purple-600 rounded-full transition-colors duration-200"></div>
                        <div class="absolute top-1 left-1 w-4 h-4 bg-white rounded-full transition-transform duration-200 peer-checked:translate-x-4"></div>
                    </div>
                </label>

                <label class="flex items-center justify-between cursor-pointer group">
                    <div class="flex flex-col">
                        <span class="text-sm font-medium text-white">Numbers</span>
                        <span class="text-xs text-zinc-500">Include 0–9</span>
                    </div>
                    <div class="relative">
                        <input id="toggle-numbers" type="checkbox" checked class="sr-only peer" onchange="generate()" />
                        <div class="w-10 h-6 bg-zinc-700 peer-checked:bg-purple-600 rounded-full transition-colors duration-200"></div>
                        <div class="absolute top-1 left-1 w-4 h-4 bg-white rounded-full transition-transform duration-200 peer-checked:translate-x-4"></div>
                    </div>
                </label>

                <label class="flex items-center justify-between cursor-pointer group">
                    <div class="flex flex-col">
                        <span class="text-sm font-medium text-white">Symbols</span>
                        <span class="text-xs text-zinc-500">Include !@@#$%^&*</span>
                    </div>
                    <div class="relative">
                        <input id="toggle-symbols" type="checkbox" class="sr-only peer" onchange="generate()" />
                        <div class="w-10 h-6 bg-zinc-700 peer-checked:bg-purple-600 rounded-full transition-colors duration-200"></div>
                        <div class="absolute top-1 left-1 w-4 h-4 bg-white rounded-full transition-transform duration-200 peer-checked:translate-x-4"></div>
                    </div>
                </label>
            </div>

        </div>
        <button onclick="generate()"
                class="w-full flex items-center justify-center gap-2 bg-purple-700 hover:bg-purple-600 active:scale-95 transition-all duration-150 text-white text-sm font-semibold rounded-xl py-3 px-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z" clip-rule="evenodd" />
            </svg>
            Generate Password
        </button>
</div>
 
 <script>
    const lower = 'abcdefghijklmnopqrstuvwxyz'
    const upper = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'
    const numbers = '0123456789'
    const symbols = '!@@#$%^&*()-_=+[]{}|;:,.<>?'

    function onSlider(val) {
        document.getElementById('length-display').textContent = val
        generate()
    }

    function generate() {
        const length = parseInt(document.getElementById('length-slider').value)
        const useUpper = document.getElementById('toggle-uppercase').checked
        const useNumbers = document.getElementById('toggle-numbers').checked
        const useSymbols = document.getElementById('toggle-symbols').checked

        let charset = lower
        if (useUpper) charset += upper
        if (useNumbers) charset += numbers
        if (useSymbols) charset += symbols

        // Guarantee at least one char from each enabled set
        let password = ''
        if (useUpper) password += upper[Math.floor(Math.random() * upper.length)]
        if (useNumbers) password += numbers[Math.floor(Math.random() * numbers.length)]
        if (useSymbols) password += symbols[Math.floor(Math.random() * symbols.length)]

        // Fill the rest randomly
        for (let i = password.length; i < length; i++) {
            password += charset[Math.floor(Math.random() * charset.length)]
        }

        // Shuffle so guaranteed chars aren't always at the start
        password = password.split('').sort(() => Math.random() - 0.5).join('')

        document.getElementById('generated-password').value = password
        updateStrength(password)
    }

    function updateStrength(password) {
        if (!password) return
        const result = window.getPasswordStrength(password)
        const score = result.score

        let label, labelColor, activeColor, activeBars
        if (score <= 1)      { label = 'Weak';   labelColor = 'text-red-400';    activeColor = 'bg-red-500';    activeBars = 1 }
        else if (score === 2) { label = 'Fair';   labelColor = 'text-yellow-400'; activeColor = 'bg-yellow-500'; activeBars = 2 }
        else if (score === 3) { label = 'Good';   labelColor = 'text-green-400';  activeColor = 'bg-green-500';  activeBars = 3 }
        else                  { label = 'Strong'; labelColor = 'text-sky-400';    activeColor = 'bg-sky-500';    activeBars = 4 }

        for (let i = 1; i <= 4; i++) {
            document.getElementById(`bar-${i}`).className =
                `h-1 flex-1 rounded-full transition-colors duration-300 ${i <= activeBars ? activeColor : 'bg-zinc-700'}`
        }

        const el = document.getElementById('strength-label')
        el.textContent = label
        el.className = `text-xs font-medium ${labelColor}`
    }

    function copyPassword() {
        const val = document.getElementById('generated-password').value
        if (!val) return
        navigator.clipboard.writeText(val).then(() => {
            document.getElementById('copy-icon').classList.add('hidden')
            document.getElementById('check-icon').classList.remove('hidden')
            setTimeout(() => {
                document.getElementById('copy-icon').classList.remove('hidden')
                document.getElementById('check-icon').classList.add('hidden')
            }, 2000)
        })
    }
    
    // Generate on load
    generate()
</script>